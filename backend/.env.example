APP_ENV=development
# Local-only demo; use PostgreSQL and HTTPS for shared deployment.
# DATABASE_URL=postgresql+psycopg://onecase:YOUR_PASSWORD@127.0.0.1:5432/onecase
# Neon CLI writes actual values to root .env.local; set these privately on Render.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
STORAGE_BACKEND=neon
STORAGE_BUCKET=assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_WRITES=30 per minute
RATE_LIMIT_LOGIN=5 per minute
MAX_UPLOAD_BYTES=3145728
API_HOST=127.0.0.1
API_PORT=5000
FRONTEND_PROXY_SECRET=
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
STEP_UP_MINUTES=10
SECRET_KEY=GENERATE_A_RANDOM_KEY
MFA_ENCRYPTION_KEY=GENERATE_WITH_FERNET
# MODEL_PATH=/absolute/path/to/.runtime/models
# STORAGE_PATH=/absolute/path/to/.runtime/documents
CLAMAV_HOST=
CLAMAV_PORT=3310
DOCUMENT_LIMIT_PER_CASE=30
JOB_LIMIT_PER_HOUR=30
SECURITY_CONTACT=Local demonstration administrator
