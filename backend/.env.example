APP_ENV=development
# Local-only demo; use PostgreSQL and HTTPS for shared deployment.
# DATABASE_URL=postgresql+psycopg://onecase:YOUR_PASSWORD@127.0.0.1:5432/onecase
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
STEP_UP_MINUTES=10
SECRET_KEY=GENERATE_A_RANDOM_KEY
MFA_ENCRYPTION_KEY=GENERATE_WITH_FERNET
# MODEL_PATH=/absolute/path/to/.runtime/models
# STORAGE_PATH=/absolute/path/to/.runtime/documents
CLAMAV_HOST=
CLAMAV_PORT=3310
DOCUMENT_LIMIT_PER_CASE=30
JOB_LIMIT_PER_HOUR=30
SECURITY_CONTACT=Local demonstration administrator
