# Render API production template. Replace every placeholder privately in Render.
# No values from a pasted credential list are retained in this template.
API_HOST=0.0.0.0
# Render injects PORT automatically; leave PORT/API_PORT unset on Render.
APP_ENV=production
COOKIE_SECURE=true

DATABASE_URL=<NEW_POOLED_NEON_DATABASE_URL>
DATABASE_URL_UNPOOLED=<NEW_DIRECT_NEON_DATABASE_URL>
# Correct spelling is UNPOOLED, not UNPOLLED.

SECRET_KEY=<NEW_RANDOM_APPLICATION_SECRET_AT_LEAST_32_CHARACTERS>
MFA_ENCRYPTION_KEY=<VALID_FERNET_KEY_COORDINATED_WITH_EXISTING_MFA_RECOVERY>
FRONTEND_PROXY_SECRET=<NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_IDENTICAL_ON_VERCEL>

RATE_LIMIT_STORAGE_URI=<REDIS_OR_REDISS_CONNECTION_URL>
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_WRITES=30 per minute

STORAGE_BACKEND=neon
STORAGE_BUCKET=assets
NEON_STORAGE_ENDPOINT=<PRIVATE_NEON_S3_ENDPOINT>
NEON_STORAGE_REGION=<NEON_STORAGE_REGION>
NEON_STORAGE_ACCESS_KEY_ID=<NEON_STORAGE_ACCESS_KEY>
NEON_STORAGE_SECRET_ACCESS_KEY=<NEON_STORAGE_SECRET_KEY>

MALWARE_SCAN_ENABLED=false
# Explicit bypass: parser validation still runs; files are labelled unscanned, never clean.
# Set the same value on API and worker. No ClamAV service is needed in bypass mode.
# To restore scanning: configure CLAMAV_HOST / CLAMAV_PORT=3310 and set
# MALWARE_SCAN_ENABLED=true on both services. Unscanned files become blocked
# until the worker scans them. Missing/unknown flag values keep scanning enabled.
# MODEL_PATH and STORAGE_PATH: remove Windows paths; use backend runtime defaults.
# The Render worker build installs model dependencies and downloads pinned artifacts.

PUBLIC_APP_URL=https://sih-solution-kappa.vercel.app
SENDGRID_API_KEY=<NEW_SENDGRID_MAIL_SEND_KEY>
SENDGRID_FROM_EMAIL=<VERIFIED_SENDGRID_SENDER_EMAIL>
SENDGRID_FROM_NAME=OneCase

DOCUMENT_LIMIT_PER_CASE=30
MAX_UPLOAD_BYTES=3145728
JOB_LIMIT_PER_HOUR=30
SESSION_IDLE_MINUTES=30
STEP_UP_MINUTES=10
PUBLIC_INTAKE_OWNER_ID=0
SECURITY_CONTACT=<YOUR_APPROVED_SUPPORT_CONTACT>
# Keep false for real-data production. Enable only for a synthetic public demo.
DEMO_ACCOUNTS_ENABLED=false
