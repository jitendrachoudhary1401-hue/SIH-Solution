# OneCase Environment Configuration
# Copy this file to .env and replace placeholders with production values

# Database Connection (PostgreSQL with psycopg3 binary driver or SQLite for local dev)
FLASK_APP=wsgi.py
DATABASE_URL=postgresql+psycopg://onecase_user:your_secure_password_here@localhost:5432/onecase_db

# Security & Sessions
COOKIE_SECURE=true
SECRET_KEY=generate_a_random_32_byte_hex_string_here

# Local Storage Path for Evidence / Attachments
STORAGE_PATH=/path/to/secure/storage/documents

# Pinned Model Artifacts Directory
MODEL_PATH=/path/to/pinned/models

# Synthetic Demo Provisioning Password
DEMO_PASSWORD=your_initial_demo_password_min_12_chars

# Gmail SMTP Email OTP Authentication
# Use a 16-character Google App Password (not your primary Gmail password)
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Initial Administrator Provisioning (Used by CLI: flask provision-initial-admin)
INITIAL_ADMIN_EMAIL=admin@yourdomain.gov.in
INITIAL_ADMIN_NAME=Chief Administrator
INITIAL_ADMIN_PASSWORD=your_initial_admin_password_min_12_chars

